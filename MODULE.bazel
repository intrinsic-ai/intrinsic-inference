module(
    name = "intrinsic_inference",
    version = "0.0.1",
)

# Bazel dependencies
bazel_dep(name = "abseil-cpp", version = "20250814.2")
bazel_dep(name = "abseil-py", version = "2.1.0", repo_name = "com_google_absl_py")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "com_github_mvukov_rules_ros2", version = "0.0.0-20260718-352a8e3")
bazel_dep(name = "fmt", version = "12.2.0")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2", repo_name = "com_google_googletest")
bazel_dep(name = "open-inference-protocol", version = "0.0.0-20250512-d49cc23.bcr.1", repo_name = "open_inference_protocol")
bazel_dep(name = "protobuf", version = "32.1", repo_name = "com_google_protobuf")
bazel_dep(name = "grpc", version = "1.74.1", repo_name = "com_github_grpc_grpc")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_python", version = "2.0.2")
bazel_dep(name = "rules_uv", version = "0.89.2")

# Hermetic C++ toolchain (LLVM)
bazel_dep(name = "toolchains_llvm", version = "1.7.0")

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    llvm_version = "19.1.0",
)

non_module_deps = use_extension("//bazel:non_module_deps.bzl", "non_module_deps_ext")
use_repo(non_module_deps, "intrinsic_llvm_sysroot")

llvm.sysroot(
    label = "@intrinsic_llvm_sysroot//:all_files",
    targets = ["linux-x86_64"],
)
use_repo(llvm, "llvm_toolchain")

register_toolchains("@llvm_toolchain//:all")

extension_for_rules_ros2 = use_extension("@com_github_mvukov_rules_ros2//ros2:extensions.bzl", "non_module_deps")
use_repo(
    extension_for_rules_ros2,
    "ros2_common_interfaces",
    "ros2_rcl_interfaces",
    "ros2_rclpy",
    "ros2_rosidl",
)

# Get the tensor_msgs package from source.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "ros2_tensor_msgs",
    build_file = "//bazel:tensor_msgs.BUILD.bazel",
    sha256 = "e6ff4cac00b7f4be4f54e4a2cb0f67ef3f8e9d20c98c6baf32d6bcfd70d41117",
    strip_prefix = "rosidl_buffer_backends-0.1.1/tensor_msgs",
    urls = ["https://github.com/ros2/rosidl_buffer_backends/archive/refs/tags/0.1.1.tar.gz"],
)

# Python toolchain & pip deps
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.11",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "intrinsic_inference_pip_deps",
    python_version = "3.11",
    requirements_lock = "//:requirements.txt",
)
use_repo(pip, "intrinsic_inference_pip_deps")
